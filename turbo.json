{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".astro/**"
            ],
            "env": [
                "USING_LOCAL_MODEL",
                "LOCAL_LLM_PROVIDER",
                "LOCAL_LLM_MODEL",
                "LOCAL_LLM_API_KEY",
                "CLANKER_CEREBRO_INGEST_TOKEN"
            ]
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "outputs": [],
            "inputs": [
                "src/**/*",
                "package.json"
            ]
        },
        "deploy": {
            "dependsOn": [
                "build"
            ],
            "cache": false
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ],
            "env": [
                "PLANNER_MODEL_PROVIDER",
                "PLANNER_MODEL",
                "PLANNER_API_KEY",
                "PLANNER_BASE_URL",
                "PLANNER_TEMPERATURE",
                "PLANNER_STREAMING",
                "WRITER_MODEL_PROVIDER",
                "WRITER_MODEL",
                "WRITER_API_KEY",
                "WRITER_BASE_URL",
                "WRITER_TEMPERATURE",
                "WRITER_STREAMING",
                "PUBLISHER_MODEL_PROVIDER",
                "PUBLISHER_MODEL",
                "PUBLISHER_API_KEY",
                "PUBLISHER_BASE_URL",
                "PUBLISHER_TEMPERATURE",
                "PUBLISHER_STREAMING",
                "GITHUB_USERNAME"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
